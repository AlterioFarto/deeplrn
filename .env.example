# Copy to `.env` and adjust. Every value is a *sample* — generate real secrets
# yourself (e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`).

# --- Core (required in production) ---
DEEPLRN_SECRET_KEY=change-me-generate-a-real-64-char-random-string
DEEPLRN_DEBUG=false
DEEPLRN_ALLOWED_HOSTS=localhost,127.0.0.1
DEEPLRN_CSRF_TRUSTED_ORIGINS=https://your-site.example.com

# --- Data stores ---
# Omit DEEPLRN_DATABASE_URL to use local SQLite in development.
DEEPLRN_DATABASE_URL=postgres://deeplrn:deeplrn-local@localhost:5432/deeplrn
DEEPLRN_REDIS_URL=redis://localhost:6379/0
DEEPLRN_DB_CONN_MAX_AGE=60
DEEPLRN_CACHE_TTL=60

# --- Celery ---
DEEPLRN_CELERY_BROKER_URL=redis://localhost:6379/1
DEEPLRN_CELERY_EAGER=false

# --- Email ---
# Omit DEEPLRN_EMAIL_URL in development to print emails to the console.
# Production: DEEPLRN_EMAIL_URL=smtp://user:pass@smtp.example.com:587
DEEPLRN_DEFAULT_FROM_EMAIL=DEEPLRN <no-reply@your-site.example.com>

# --- Security knobs ---
DEEPLRN_SESSION_AGE_SECONDS=43200
DEEPLRN_LOGIN_MAX_ATTEMPTS=5
DEEPLRN_LOGIN_LOCKOUT_SECONDS=900
DEEPLRN_HSTS_SECONDS=63072000
DEEPLRN_SECURE_SSL_REDIRECT=true

# --- Behaviour ---
DEEPLRN_LANGUAGE_CODE=en
DEEPLRN_TIME_ZONE=UTC
DEEPLRN_LOG_LEVEL=INFO
DEEPLRN_PAGE_SIZE=25
DEEPLRN_MAX_PAGE_SIZE=100
DEEPLRN_ATTENDANCE_RISK_THRESHOLD=75
DEEPLRN_MONTHLY_INVOICE_AMOUNT=500.00
DEEPLRN_REPORTS_ROOT=reports

# --- Error tracking (optional) ---
# DEEPLRN_SENTRY_DSN=https://key@sentry.example.com/1
# DEEPLRN_SENTRY_TRACES_RATE=0.1
# DEEPLRN_RELEASE=deeplrn@1.0.0

# --- Development-only helpers (never set in production) ---
# DEEPLRN_SEED_DEMO=false
